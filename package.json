{
  "name": "@dappermountain/payload-plugin-achievements",
  "version": "0.2.11",
  "description": "A robust, Admin-configured achievements engine for Payload: composable unlock rules, derived rank progress, request/review grants, metrics, and scoped multi-tenant support.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DapperMountain/payload-plugin-achievements.git"
  },
  "bugs": {
    "url": "https://github.com/DapperMountain/payload-plugin-achievements/issues"
  },
  "homepage": "https://github.com/DapperMountain/payload-plugin-achievements#readme",
  "author": "Dapper Mountain",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "achievements",
    "gamification",
    "tiers",
    "grants"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "bun run build",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\" \"*.md\"",
    "agents:sync": "bunx @dappermountain/agent-payload sync",
    "skills:install": "bunx skills add payloadcms/skills --skill payload -y --copy -a cursor",
    "skills:update": "bunx skills update payload -y -p",
    "skills:check": "bunx skills check -p"
  },
  "peerDependencies": {
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "lucide-react": "^0.543.0",
    "payload": "^3.88.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@dappermountain/agent-payload": "^0.1.5",
    "@dappermountain/agent-practices": "^0.1.2",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@types/bun": "1.4.0",
    "@types/react": "^19.0.0",
    "lucide-react": "0.543.0",
    "payload": "3.88.0",
    "prettier": "^3.6.2",
    "react": "19.2.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
